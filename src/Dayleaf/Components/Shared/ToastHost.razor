@implements IDisposable
@inject ToastService Toasts

<div class="toasts" role="status" aria-live="polite">
    @foreach (var t in Toasts.Items)
    {
        <div class="toast toast-@t.Kind.ToString().ToLowerInvariant()" @key="t.Id">
            <Icon Name="@(t.Kind == ToastKind.Error ? "close" : t.Kind == ToastKind.Success ? "tick" : "sparkle")" Size="16" />
            <span>@t.Text</span>
            <button type="button" class="toast-x" aria-label="@L["Dismiss"]" @onclick="() => Toasts.Dismiss(t.Id)"><Icon Name="close" Size="14" /></button>
        </div>
    }
</div>

@code {
    protected override void OnInitialized() => Toasts.Changed += OnChanged;
    private void OnChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => Toasts.Changed -= OnChanged;
}
