@if (Open)
{
    <div class="modal-backdrop" @onclick="Close"></div>
    <div class="modal @(Wide ? "modal-wide" : "")" role="dialog" aria-modal="true" aria-labelledby="@_titleId" @onkeydown="OnKey">
        <header class="modal-head">
            <h2 id="@_titleId">@Title</h2>
            <button type="button" class="icon-btn" aria-label="@L["Close"]" @onclick="Close"><Icon Name="close" /></button>
        </header>
        <div class="modal-body">@ChildContent</div>
        @if (Footer is not null)
        {
            <footer class="modal-foot">@Footer</footer>
        }
    </div>
}

@code {
    private readonly string _titleId = "m" + Guid.NewGuid().ToString("N")[..8];
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public bool Wide { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Footer { get; set; }

    private Task Close() => OpenChanged.InvokeAsync(false);

    private Task OnKey(KeyboardEventArgs e) => e.Key == "Escape" ? Close() : Task.CompletedTask;
}
