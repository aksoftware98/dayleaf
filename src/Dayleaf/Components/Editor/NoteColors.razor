@if (IncludePaper)
{
    <ColorSwatches Items="WithPaper" Value="@Value" ValueChanged="ValueChanged" Label="@L["Paper color"]" Background="Bg" />
}
else
{
    <ColorSwatches Items="Palette.Papers" Value="@Value" ValueChanged="ValueChanged" Label="@L["Paper color"]" />
}

@code {
    [Parameter] public string Value { get; set; } = "yellow";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public bool IncludePaper { get; set; }

    private static readonly IReadOnlyList<Palette.Swatch> WithPaper = [.. Palette.Papers, new("paper", "No paper", "transparent")];

    private static string Bg(Palette.Swatch s) =>
        s.Id == "paper" ? "linear-gradient(135deg,#fff 45%,#d33 46% 54%,#fff 55%)" : s.Hex;
}
