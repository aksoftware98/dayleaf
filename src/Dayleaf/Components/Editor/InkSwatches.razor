@{
    var t = Themes.Get(Theme);
    var themed = ForShapes
        ? new[] { ("accent", L["Theme accent"], t.Accent), ("accent2", L["Theme accent 2"], t.Accent2), ("chip", L["Soft tint"], Mix(t.Accent2)), ("note", L["Note paper"], "#F6E7B8"), ("ink", L["Theme ink"], t.Ink) }
        : new[] { ("ink", L["Theme ink"], t.Ink), ("accent", L["Theme accent"], t.Accent), ("accent2", L["Theme accent 2"], t.Accent2), ("muted", L["Muted"], "#8A8F86") };
}
<div class="ink-picker">
    <span class="hint">@L["From the theme"]</span>
    <div class="swatches swatches-sm" role="group" aria-label="@L["Theme colors"]">
        @foreach (var (id, name, hex) in themed)
        {
            <button type="button" class="swatch swatch-theme" style="background:@hex" aria-label="@name" title="@name" aria-pressed="@(Value == id ? "true" : "false")"
                    @onclick="() => ValueChanged.InvokeAsync(id)"></button>
        }
    </div>
    <span class="hint">@L["Any theme"]</span>
    <ColorSwatches Items="Palette.FixedInks" Value="@Value" ValueChanged="ValueChanged" Label="@L["Colors"]" />
</div>

@code {
    [Parameter] public string Value { get; set; } = "ink";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string Theme { get; set; } = Themes.Default;
    [Parameter] public bool ForShapes { get; set; }

    private static string Mix(string hex) => $"color-mix(in srgb, {hex} 35%, white)";
}
