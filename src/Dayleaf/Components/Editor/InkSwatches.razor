@{
    var t = Themes.Get(Theme);
    var themed = ForShapes
        ? new[] { ("accent", "Theme accent", t.Accent), ("accent2", "Theme accent 2", t.Accent2), ("chip", "Soft tint", Mix(t.Accent2)), ("note", "Note paper", "#F6E7B8"), ("ink", "Theme ink", t.Ink) }
        : new[] { ("ink", "Theme ink", t.Ink), ("accent", "Theme accent", t.Accent), ("accent2", "Theme accent 2", t.Accent2), ("muted", "Muted", "#8A8F86") };
}
<div class="ink-picker">
    <span class="hint">From the theme</span>
    <div class="swatches swatches-sm" role="group" aria-label="Theme colors">
        @foreach (var (id, name, hex) in themed)
        {
            <button type="button" class="swatch swatch-theme" style="background:@hex" aria-label="@name" title="@name" aria-pressed="@(Value == id ? "true" : "false")"
                    @onclick="() => ValueChanged.InvokeAsync(id)"></button>
        }
    </div>
    <span class="hint">Any theme</span>
    <ColorSwatches Items="Palette.FixedInks" Value="@Value" ValueChanged="ValueChanged" Label="Colors" />
</div>

@code {
    [Parameter] public string Value { get; set; } = "ink";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string Theme { get; set; } = Themes.Default;
    [Parameter] public bool ForShapes { get; set; }

    private static string Mix(string hex) => $"color-mix(in srgb, {hex} 35%, white)";
}
