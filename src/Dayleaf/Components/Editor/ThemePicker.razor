@* Theme gallery, grouped. Each card previews the theme's real background, title font and accents. *@
<div class="theme-groups" role="group" aria-label="@L["Page theme"]">
    @foreach (var g in Themes.Groups)
    {
        <div class="theme-group">
            <span class="theme-group-name">@L[g.Name]</span>
            <div class="themes">
                @foreach (var t in Themes.All.Where(x => x.Group == g.Id))
                {
                    <button type="button" class="theme-card tc-@t.Id" aria-pressed="@(Value == t.Id ? "true" : "false")" title="@L[t.Blurb]" disabled="@Disabled"
                            style="background:@t.PreviewBackground" @onclick="() => ValueChanged.InvokeAsync(t.Id)">
                        <span class="aa" style="font-family:@t.TitleFont;color:@t.Ink;@AaStyle(t)">Aa</span>
                        <span class="dots"><i style="background:@t.Accent"></i><i style="background:@t.Accent2"></i></span>
                        <span class="nm" style="color:@t.Ink">@L[t.Name]</span>
                    </button>
                }
            </div>
        </div>
    }
    @if (ShowShuffle)
    {
        <button type="button" class="theme-card shuffle" disabled="@Disabled" @onclick="Shuffle"><Icon Name="shuffle" Size="16" />@L["Shuffle"]</button>
    }
</div>

@code {
    [Parameter] public string Value { get; set; } = Themes.Default;
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public bool ShowShuffle { get; set; } = true;
    [Parameter] public bool Disabled { get; set; }

    private static string AaStyle(ThemeInfo t) => t.TitleStyle switch
    {
        "italic" => "font-style:italic",
        "bold" => "font-weight:700",
        "light" => "font-weight:300",
        "hand" => "font-weight:700;font-size:24px",
        _ => "",
    };

    private Task Shuffle()
    {
        var others = Themes.All.Where(t => t.Id != Value).ToList();
        return ValueChanged.InvokeAsync(others[Random.Shared.Next(others.Count)].Id);
    }
}
