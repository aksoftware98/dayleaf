@inject IPageService Pages
@inject NavigationManager Nav
@inject ToastService Toasts
@inject IJSRuntime JS

<Modal Open="Open" OpenChanged="OpenChanged" Title="@L["Share & export"]">
    <div class="share-box">
        <label class="toggle">
            <span>
                <strong style="display:block">@L["Public link"]</strong>
                <span class="hint">@L["Anyone with the link can view this page (read-only). Turn it off and the old link stops working."]</span>
            </span>
            <input type="checkbox" checked="@(_token is not null)" @onchange="ToggleAsync" aria-label="@L["Public link"]" />
        </label>
        @if (_token is not null)
        {
            <div class="share-url">
                <input class="input" readonly value="@Url" aria-label="@L["Share link"]" dir="ltr" />
                <button type="button" class="btn btn-secondary" @onclick="CopyAsync"><Icon Name="copy" Size="16" />@L["Copy"]</button>
            </div>
            <a class="btn btn-ghost" href="@($"/p/{_token}")" target="_blank" rel="noopener"><Icon Name="eye" Size="16" />@L["Open the public page"]</a>
        }
        <div class="smallcaps" style="margin-top:6px">@L["Export this page"]</div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px">
            <a class="btn btn-secondary" href="@($"/export/page/{PageId}.pdf")" download><Icon Name="download" Size="16" />@L["PDF (A4)"]</a>
            <a class="btn btn-secondary" href="@($"/print/page/{PageId}")" target="_blank" rel="noopener"><Icon Name="print" Size="16" />@L["Print"]</a>
            <a class="btn btn-secondary" href="@($"/export/page/{PageId}.html")" download><Icon Name="file" Size="16" />@L["HTML file"]</a>
            <a class="btn btn-secondary" href="@($"/export/page/{PageId}.dayleaf")" download style="grid-column:span 2"><Icon Name="download" Size="16" />@L[".dayleaf (move to another notebook)"]</a>
        </div>
        <p class="hint" style="margin:0">@L["PDF (A4) is made on this computer: exactly one full-bleed A4 page per sheet. Printing yourself? Use margins None and scale 100%."]</p>
    </div>
</Modal>

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter] public Guid PageId { get; set; }
    [Parameter] public string? ShareToken { get; set; }
    [Parameter] public EventCallback<string?> ShareTokenChanged { get; set; }

    private string? _token;
    private bool _wasOpen;
    private string Url => Nav.ToAbsoluteUri($"/p/{_token}").ToString();

    protected override void OnParametersSet()
    {
        if (Open && !_wasOpen) _token = ShareToken;
        _wasOpen = Open;
    }

    private async Task ToggleAsync(ChangeEventArgs e)
    {
        if (e.Value is true)
        {
            _token = await Pages.EnableShareAsync(PageId);
            Toasts.Success(L["Public link is on"]);
        }
        else
        {
            await Pages.DisableShareAsync(PageId);
            _token = null;
            Toasts.Show(L["Public link turned off — the old link no longer works"]);
        }
        await ShareTokenChanged.InvokeAsync(_token);
    }

    private async Task CopyAsync()
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", Url);
        Toasts.Success(L["Link copied"]);
    }
}
