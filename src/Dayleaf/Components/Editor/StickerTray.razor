@* Curated emoji stickers. Click to add, or drag onto the page. *@
<div class="insp-group">
    <span class="smallcaps">@L["Drag a sticker onto the page"]</span>
    <div class="searchbox" style="min-width:0;height:40px">
        <Icon Name="search" Size="14" />
        <input type="search" placeholder="@L["Find a sticker…"]" aria-label="@L["Find a sticker"]" @bind="_q" @bind:event="oninput" />
    </div>
    @if (string.IsNullOrWhiteSpace(_q))
    {
        <div class="sticker-cats" role="group" aria-label="@L["Sticker sets"]">
            @foreach (var c in EmojiCatalog.Categories)
            {
                <button type="button" aria-pressed="@(_cat == c.Id ? "true" : "false")" @onclick="() => _cat = c.Id">@L[c.Name]</button>
            }
        </div>
    }
    <div class="stickers">
        @foreach (var s in Items)
        {
            <button type="button" class="sticker-btn" draggable="true" data-sticker="@s.Char" aria-label="@s.LocalName" title="@s.LocalName" disabled="@Disabled"
                    @onclick="() => OnPick.InvokeAsync(s.Char)">@s.Char</button>
        }
    </div>
    @if (!Items.Any())
    {
        <span class="hint">@L["No sticker matches. Type any emoji in the box and press Enter."]</span>
    }
    <form @onsubmit="AddCustom" style="display:flex;gap:6px">
        <input class="input" style="min-height:38px" placeholder="@L["Or paste any emoji"]" aria-label="@L["Any emoji"]" maxlength="8" @bind="_custom" @bind:event="oninput" />
        <button type="submit" class="btn btn-secondary btn-sm" disabled="@(Disabled || string.IsNullOrWhiteSpace(_custom))">@L["Add"]</button>
    </form>
</div>

@code {
    [Parameter] public EventCallback<string> OnPick { get; set; }
    [Parameter] public bool Disabled { get; set; }

    private string _cat = "nature";
    private string? _q, _custom;

    private IEnumerable<EmojiCatalog.Sticker> Items => string.IsNullOrWhiteSpace(_q)
        ? EmojiCatalog.Categories.First(c => c.Id == _cat).Items
        : EmojiCatalog.All.Where(s => s.Matches(_q)).Take(36);

    private async Task AddCustom()
    {
        if (string.IsNullOrWhiteSpace(_custom)) return;
        await OnPick.InvokeAsync(_custom.Trim());
        _custom = null;
    }
}
