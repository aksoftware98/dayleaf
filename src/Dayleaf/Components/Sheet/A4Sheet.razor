@using System.Globalization
@* One rendering path for editor, thumbnails, print, share and HTML export.
   No Blazor event handlers in here: the editor talks to it through dayleaf.js, so it also renders statically.
   Printed text (header, dates, footer) follows the page's language; edit hints follow the app's language. *@

<div class="sheets mode-@Mode.ToString().ToLowerInvariant() @Class"
     data-page-id="@Model.PageId"
     data-meta-editable="@(Mode == SheetMode.Edit && MetaEditable ? "true" : null)">
    @for (var i = 0; i < Model.SheetCount; i++)
    {
        var sheet = i;
        <article class="sheet theme-@Model.Theme" lang="@Pl" dir="@Lang.Dir(Pl)" data-sheet="@sheet"
                 aria-label="@($"{Model.SpaceName}, {Dates.Format(Model.Date, DateStyle.LongNoWeekday, Pl)}, {P("sheet")} {sheet + 1}")">
            <div class="sheet-deco" aria-hidden="true"></div>
            @if (sheet == 0)
            {
                <header class="sh-head">
                    <div class="sh-run">
                        <span><bdi>@Upper(Model.SpaceName)</bdi>&nbsp;&nbsp;·&nbsp;&nbsp;@P("PAGE") @Model.PageNumber</span>
                        <span class="sh-brand">dayleaf</span>
                    </div>
                    <div class="sh-rule"></div>
                    <span class="sh-day">@Model.Date.Day.ToString("00", CultureInfo.InvariantCulture)</span>
                    <div class="sh-month">
                        <span class="sh-month-name">@Dates.Format(Model.Date, DateStyle.Month, Pl)</span>
                        <span class="sh-yw">
                            <span class="sh-year">@Model.Date.Year</span><span class="sh-dot"> · </span><span class="sh-wd">@Upper(Dates.Format(Model.Date, DateStyle.Weekday, Pl))</span>
                        </span>
                    </div>
                    @if (Model.Tags.Count > 0)
                    {
                        <div class="sh-tags">
                            @for (var t = 0; t < Model.Tags.Count; t++)
                            {
                                <span class="sh-chip chip-@(t % 3)" dir="auto">@Model.Tags[t]</span>
                            }
                        </div>
                    }
                    <h1 class="sh-title" @key="TitleVersion" dir="auto" data-page-field="@(Mode == SheetMode.Edit && MetaEditable ? "title" : null)" data-placeholder="@L["Name this day…"]">@Model.Title</h1>
                </header>
            }
            else
            {
                <header class="sh-head sh-head-small">
                    <div class="sh-run">
                        <span><bdi>@Upper(Model.SpaceName)</bdi>&nbsp;&nbsp;·&nbsp;&nbsp;@P("PAGE") @Model.PageNumber&nbsp;&nbsp;·&nbsp;&nbsp;@P("SHEET") @(sheet + 1)</span>
                        <span class="sh-brand">@Dates.Format(Model.Date, DateStyle.Short, Pl)</span>
                    </div>
                    <div class="sh-rule"></div>
                </header>
            }

            @foreach (var se in Model.Elements)
            {
                if (se.Element.Sheet != sheet) continue;
                <ElementView @key="se.Element.Id" Item="se" Model="Model" Mode="Mode" Selected="se.Element.Id == SelectedId" />
            }

            <footer class="sh-foot">
                <div class="sh-foot-rule"></div>
                <div class="sh-foot-row">
                    <span><bdi>@Model.SpaceEmoji @Model.SpaceName</bdi></span>
                    <span>@Dates.Format(Model.Date, DateStyle.Footer, Pl)&nbsp;&nbsp;·&nbsp;&nbsp;<strong>@Model.PageNumber</strong>@(Model.SheetCount > 1 ? $"  ·  {sheet + 1}/{Model.SheetCount}" : "")</span>
                </div>
            </footer>
        </article>
    }
</div>

@code {
    [Parameter, EditorRequired] public SheetModel Model { get; set; } = default!;
    [Parameter] public SheetMode Mode { get; set; } = SheetMode.View;
    [Parameter] public Guid? SelectedId { get; set; }
    [Parameter] public bool MetaEditable { get; set; }
    [Parameter] public string? Class { get; set; }
    /// <summary>Bumped after an inline title edit so the edited DOM node is replaced, not patched.</summary>
    [Parameter] public int TitleVersion { get; set; }

    /// <summary>The page's language.</summary>
    private string Pl => Lang.Normalize(Model.Language);

    /// <summary>Printed sheet text, in the page's language.</summary>
    private string P(string key) => Loc.TFor(Pl, key);

    /// <summary>Arabic has no capitals; only Latin text is upper-cased.</summary>
    private string Upper(string s) => Pl == Lang.Ar ? s : s.ToUpper(CultureInfo.InvariantCulture);
}
