@page "/not-found"
@attribute [AllowAnonymous]
@layout PrintLayout

<PageTitle>@L["Not found"] · Dayleaf</PageTitle>

<main class="page-wrap" style="min-height:100vh;justify-content:center">
    <EmptyState IconName="search" Title="@L["This page isn't in the notebook"]" Text="@L["The link may be old, the page may have been deleted, or sharing was turned off."]">
        <div class="empty-actions"><a class="btn btn-primary" href="/">@L["Go to Dayleaf"]</a></div>
    </EmptyState>
</main>
