@page "/"
@inject ISpaceService Spaces
@inject ITimelineService Timeline
@inject IPageService Pages
@inject SeedService Seed
@inject TimeProvider Clock
@inject NavigationManager Nav
@inject AppEvents Events
@inject ToastService Toasts

<PageTitle>Dayleaf</PageTitle>

<div class="page-wrap">
    <header class="home-head">
        <div style="display:flex;flex-direction:column;gap:6px">
            <span class="home-date">@L.Date(_now.DateTime, DateStyle.Long)</span>
            <h1 class="page-title">@Greeting</h1>
        </div>
        <div style="display:flex;flex-wrap:wrap;gap:12px;align-items:center">
            <form class="searchbox" role="search" @onsubmit="SearchAsync">
                <Icon Name="search" Size="16" />
                <label class="sr-only" for="home-q">@L["Search pages"]</label>
                <input id="home-q" type="search" dir="auto" placeholder="@L["Search pages, dates, places…"]" @bind="_q" />
            </form>
            @if (_spaces.Count > 0)
            {
                <button type="button" class="btn btn-primary" @onclick="NewToday"><Icon Name="plus" Size="16" />@L["New page for today"]</button>
            }
        </div>
    </header>

    @if (_loaded && _spaces.Count == 0)
    {
        <EmptyState IconName="book" Title="@L["Create your first space"]" Text="@L["A space is a notebook for one part of your life — a farm, a project, a family, a trip. Each day gets its own beautiful A4 page."]">
            <div class="empty-actions">
                <button type="button" class="btn btn-primary" @onclick="() => _newSpace = true"><Icon Name="plus" Size="16" />@L["Create a space"]</button>
                <button type="button" class="btn btn-secondary" disabled="@_seeding" @onclick="SeedAsync"><Icon Name="sparkle" Size="16" />@(_seeding ? L["Planting…"] : L["Open the sample notebook"])</button>
            </div>
        </EmptyState>
    }
    else if (_loaded)
    {
        <section aria-labelledby="spaces-h" style="display:flex;flex-direction:column;gap:16px">
            <div class="section-head">
                <h2 id="spaces-h">@L["Spaces"]</h2>
                <span class="muted" style="font-size:13px">@L.Count(_spaces.Count, Noun.Space) · @L.Count(_spaces.Sum(s => s.PageCount), Noun.Page)</span>
            </div>
            <div class="space-grid">
                @foreach (var s in _spaces)
                {
                    var c = SpaceColors.Get(s.Space.Color);
                    <a class="space-card" href="@($"/s/{s.Space.Slug}")">
                        <div class="space-cover" style="background:@c.Tint">
                            @if (s.Space.CoverMediaId is { } cover)
                            {
                                <img src="/media/@cover.ToString("N")" alt="" loading="lazy" />
                            }
                            else
                            {
                                <span class="space-cover-text" dir="auto" style="color:@c.InkOnTint">@(s.Space.Description ?? L["a page for every day"])</span>
                            }
                            <span class="space-badge">@s.Space.Emoji</span>
                        </div>
                        <div class="space-info">
                            <span class="space-name" dir="auto">@s.Space.Name</span>
                            @if (s.PageCount == 0)
                            {
                                <span class="space-meta">@L["No pages yet"]</span>
                                <span class="space-cta">@L["+ Write the first page"]</span>
                            }
                            else
                            {
                                <span class="space-meta">@L.Count(s.PageCount, Noun.Page) · @RangeText(s)</span>
                                <span class="chip" style="margin-top:6px;align-self:flex-start;background:@c.Tint;color:@c.InkOnTint">@StatusText(s)</span>
                            }
                        </div>
                    </a>
                }
            </div>
        </section>

        <section aria-labelledby="recent-h" style="display:flex;flex-direction:column;gap:16px">
            <div class="section-head">
                <h2 id="recent-h">@L["Latest pages"]</h2>
                <a href="/search" style="font-size:13px;font-weight:600">@L["Search all"]</a>
            </div>
            <div class="thumb-row">
                @foreach (var (r, model) in _latest)
                {
                    <a class="thumb-link" href="@r.Url">
                        <PageThumb Model="model" Width="180" />
                        <span class="thumb-cap">
                            <strong>@L.Date(r.Date, DateStyle.Short)</strong>
                            <span><bdi>@r.SpaceName</bdi> · @L["Page {0}", r.Number]</span>
                        </span>
                    </a>
                }
                <button type="button" class="thumb-new" style="width:180px;height:255px" @onclick="NewToday">
                    <Icon Name="edit" Size="28" Stroke="1.6" />@L["Start today's page"]
                </button>
            </div>
        </section>

        @if (_onThisDay.Count > 0)
        {
            <section aria-labelledby="otd-h" style="display:flex;flex-direction:column;gap:16px">
                <div class="section-head">
                    <h2 id="otd-h">@L["On this day"]</h2>
                    <span class="hand" style="font-size:20px;color:var(--marigold-ink)">@L["{0}, in other years", L.Date(_now.DateTime, DateStyle.MonthDayLong)]</span>
                </div>
                <div class="otd">
                    @foreach (var r in _onThisDay)
                    {
                        <a class="otd-card" href="@r.Url">
                            @if (r.PhotoIds.Count > 0)
                            {
                                <img src="/media/@r.PhotoIds[0].ToString("N")" alt="" style="width:64px;height:64px;border-radius:12px;object-fit:cover" loading="lazy" />
                            }
                            else
                            {
                                <span style="width:64px;height:64px;border-radius:12px;background:var(--app-bg);display:flex;align-items:center;justify-content:center;font-size:30px">@r.SpaceEmoji</span>
                            }
                            <span style="display:flex;flex-direction:column;gap:2px;min-width:0">
                                <span class="otd-years">@YearsAgo(r.Date)</span>
                                <strong dir="auto" style="font-family:var(--font-display);font-weight:500;font-size:17px">@(string.IsNullOrWhiteSpace(r.Title) ? L["Untitled page"] : r.Title)</strong>
                                <span class="muted" style="font-size:12px"><bdi>@r.SpaceName</bdi> · @L.Date(r.Date, DateStyle.Short)</span>
                            </span>
                        </a>
                    }
                </div>
            </section>
        }
    }
</div>

<SpaceDialog @bind-Open="_newSpace" OnSaved="OnSpaceCreated" />

<Modal @bind-Open="_pickSpace" Title="@L["Today's page goes in…"]">
    <div class="picker-list">
        @foreach (var s in _spaces)
        {
            <button type="button" class="picker-item" @onclick="() => OpenToday(s.Space)">
                <span class="picker-ico">@s.Space.Emoji</span>
                <span><strong dir="auto">@s.Space.Name</strong><small>@L.Count(s.PageCount, Noun.Page)</small></span>
            </button>
        }
    </div>
</Modal>

@code {
    private List<SpaceSummary> _spaces = [];
    private List<(PageRef Ref, SheetModel? Model)> _latest = [];
    private List<PageRef> _onThisDay = [];
    private DateTimeOffset _now;
    private string? _q;
    private bool _loaded, _newSpace, _pickSpace, _seeding;

    private string Greeting => _now.Hour switch
    {
        < 5 => L["Still up? Write it down."],
        < 12 => L["Good morning."],
        < 17 => L["Good afternoon."],
        < 22 => L["Good evening."],
        _ => L["Good night."],
    };

    protected override async Task OnInitializedAsync()
    {
        _now = Clock.GetLocalNow();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _spaces = await Spaces.ListAsync();
        var latest = await Timeline.GetLatestAsync(6);
        _latest = [];
        foreach (var r in latest) _latest.Add((r, await Pages.GetSheetModelAsync(r.Id)));
        _onThisDay = await Timeline.OnThisDayAsync(DateOnly.FromDateTime(_now.DateTime));
        _loaded = true;
    }

    private void SearchAsync()
    {
        if (!string.IsNullOrWhiteSpace(_q)) Nav.NavigateTo($"/search?q={Uri.EscapeDataString(_q)}");
    }

    private void NewToday()
    {
        if (_spaces.Count == 1) OpenToday(_spaces[0].Space);
        else _pickSpace = true;
    }

    private void OpenToday(Space s) => Nav.NavigateTo($"/s/{s.Slug}/{_now:yyyy-MM-dd}?new=1");

    private async Task SeedAsync()
    {
        _seeding = true;
        try
        {
            await Seed.SeedAsync();
            Toasts.Success(L["The sample notebook is ready — have a look around."]);
            Events.NotifySpacesChanged();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Toasts.Error(L["Couldn't create the sample: {0}", ex.Message]);
        }
        finally
        {
            _seeding = false;
        }
    }

    private void OnSpaceCreated(Space s)
    {
        Events.NotifySpacesChanged();
        Nav.NavigateTo($"/s/{s.Slug}");
    }

    private string RangeText(SpaceSummary s) =>
        s.FirstDate == s.LastDate
            ? L.Date(s.LastDate!.Value, DateStyle.Short)
            : s.FirstDate!.Value.Year == s.LastDate!.Value.Year && s.PageCount > 0 && s.LastDate.Value.Year == _now.Year
                ? L["latest {0}", L.Date(s.LastDate.Value, DateStyle.MonthDay)]
                : L["{0} → {1}", L.Date(s.FirstDate.Value, DateStyle.MonthYear), L.Date(s.LastDate.Value, DateStyle.MonthYear)];

    private string StatusText(SpaceSummary s)
    {
        if (s.SharedCount > 0) return L["Shared · {0} public", L.Count(s.SharedCount, Noun.Page)];
        if (s.LastActivity is not { } a) return L["Quiet for now"];
        var days = (int)(_now - a).TotalDays;
        return days switch
        {
            0 => L["Updated today"],
            1 => L["Updated yesterday"],
            < 30 => L["Updated {0} ago", L.Count(days, Noun.Day)],
            _ => L["Last page {0}", L.Date(a.ToLocalTime().DateTime, DateStyle.MonthDay)],
        };
    }

    private string YearsAgo(DateOnly d)
    {
        var y = _now.Year - d.Year;
        return L["{0} ago", L.Count(y, Noun.Year)];
    }
}
