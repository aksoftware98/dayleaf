@page "/p/{Token}"
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@layout PrintLayout
@inject IPageService Pages
@inject NavigationManager Nav

<PageTitle>@(_model is null ? "Dayleaf" : $"{(string.IsNullOrWhiteSpace(_model.Title) ? Dates.Format(_model.Date, DateStyle.LongNoWeekday, _model.Language) : _model.Title)} · {_model.SpaceName}")</PageTitle>
<HeadContent>
    <meta name="robots" content="noindex" />
    @if (_model is not null)
    {
        <meta property="og:title" content="@(string.IsNullOrWhiteSpace(_model.Title) ? _model.SpaceName : _model.Title)" />
        <meta property="og:description" content="@($"{_model.SpaceEmoji} {_model.SpaceName} · {Dates.Format(_model.Date, DateStyle.Long, _model.Language)}")" />
    }
</HeadContent>

@if (_model is not null)
{
    <main class="share-page">
        <div class="share-head">
            <span style="font-size:28px">@_model.SpaceEmoji</span>
            <span style="display:flex;flex-direction:column">
                <strong dir="auto" style="font-family:var(--font-display);font-size:20px;font-weight:600">@_model.SpaceName</strong>
                <span class="muted" style="font-size:13px">@L.Date(_model.Date, DateStyle.Long) · @L["Page {0}", _model.PageNumber]</span>
            </span>
            <a class="btn btn-primary" href="@($"/p/{Token}.pdf")" download><Icon Name="download" Size="16" />@L["Download PDF"]</a>
            <button type="button" class="btn btn-secondary" onclick="window.print()"><Icon Name="print" Size="16" />@L["Print"]</button>
            <LanguageSwitch />
        </div>
        <div class="share-fit">
            <A4Sheet Model="_model" Mode="SheetMode.Print" />
        </div>
        <p class="share-foot">@L["made with dayleaf · a page for every day"]</p>
    </main>
}

@code {
    [Parameter] public string Token { get; set; } = "";
    private SheetModel? _model;

    protected override async Task OnInitializedAsync()
    {
        var page = await Pages.GetByShareTokenAsync(Token);
        if (page is null) { Nav.NotFound(); return; }
        _model = await Pages.GetSheetModelAsync(page.Id);
        if (_model is null) { Nav.NotFound(); return; }
        // Linked pages aren't public: render them as plain cards without their photos.
        foreach (var key in _model.LinkCards.Keys.ToList())
            if (_model.LinkCards[key] is { } c) _model.LinkCards[key] = c with { Url = "#", PhotoId = null };
    }
}
