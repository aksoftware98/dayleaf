@page "/search"
@inject ISearchService SearchService
@inject NavigationManager Nav

<PageTitle>@L["Search"] · Dayleaf</PageTitle>

<div class="page-wrap">
    <div class="search-hero">
        <h1 class="page-title">@L["Search"]</h1>
        <form class="searchbox search-big" role="search" @onsubmit="Go">
            <Icon Name="search" Size="20" />
            <label class="sr-only" for="q">@L["Search"]</label>
            <input id="q" type="search" dir="auto" placeholder="@L["tractor · june 2025 · 2026-11 · Serghaya"]" @bind="_q" @bind:event="oninput" @bind:after="DebounceAsync" autofocus />
        </form>
        <span class="hint">@L["Words match titles, tags and everything written on the page. Dates work too: 2025, 2025-06, june 2025, Jun 11 2025."]</span>
    </div>

    @if (_hits is not null)
    {
        <div class="section-head"><h2>@L.Count(_hits.Count, Noun.Result)</h2></div>
        @if (_hits.Count == 0)
        {
            <EmptyState IconName="search" Title="@L["Nothing found"]" Text="@L["Try fewer words, or a month like “june 2025”."]" />
        }
        <div class="results">
            @foreach (var h in _hits)
            {
                <a class="result" href="@h.Page.Url">
                    @if (h.Page.PhotoIds.Count > 0)
                    {
                        <img src="/media/@h.Page.PhotoIds[0].ToString("N")" alt="" style="width:84px;height:84px;border-radius:12px;object-fit:cover;flex:none" loading="lazy" />
                    }
                    else
                    {
                        <span style="width:84px;height:84px;border-radius:12px;background:var(--app-bg);display:flex;align-items:center;justify-content:center;font-size:34px;flex:none">@h.Page.SpaceEmoji</span>
                    }
                    <div style="min-width:0">
                        <span class="result-meta">@h.Page.SpaceEmoji <bdi>@h.Page.SpaceName</bdi> · @L.Date(h.Page.Date, DateStyle.WeekdayShort) · @L["Page {0}", h.Page.Number]</span>
                        <h3 dir="auto">@Highlight(string.IsNullOrWhiteSpace(h.Page.Title) ? L["Untitled page"] : h.Page.Title, h.Terms)</h3>
                        @if (!string.IsNullOrWhiteSpace(h.Snippet))
                        {
                            <p dir="auto">@Highlight(h.Snippet, h.Terms)</p>
                        }
                    </div>
                </a>
            }
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "q")] public string? Q { get; set; }

    private string? _q;
    private List<SearchHit>? _hits;
    private CancellationTokenSource? _debounce;

    protected override async Task OnParametersSetAsync()
    {
        if (Q != _q || _hits is null)
        {
            _q = Q;
            await RunAsync();
        }
    }

    private async Task DebounceAsync()
    {
        _debounce?.Cancel();
        _debounce = new CancellationTokenSource();
        var token = _debounce.Token;
        try
        {
            await Task.Delay(250, token);
            await RunAsync();
            Nav.NavigateTo($"/search?q={Uri.EscapeDataString(_q ?? "")}", replace: true);
        }
        catch (TaskCanceledException) { }
    }

    private async Task Go()
    {
        _debounce?.Cancel();
        await RunAsync();
    }

    private async Task RunAsync() => _hits = string.IsNullOrWhiteSpace(_q) ? null : await SearchService.SearchAsync(_q);

    /// <summary>Marks every match, Arabic-aware (finds أحمد when you typed احمد, and ignores tashkeel).</summary>
    private static RenderFragment Highlight(string text, IReadOnlyList<string> terms) => builder =>
    {
        var seq = 0;
        var i = 0;
        foreach (var (start, length) in ArabicText.FindMatches(text, terms))
        {
            if (start > i) builder.AddContent(seq++, text[i..start]);
            builder.OpenElement(seq++, "mark");
            builder.AddContent(seq++, text.Substring(start, length));
            builder.CloseElement();
            i = start + length;
        }
        if (i < text.Length) builder.AddContent(seq++, text[i..]);
    };
}
