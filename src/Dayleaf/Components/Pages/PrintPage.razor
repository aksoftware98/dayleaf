@page "/print/page/{Id:guid}"
@attribute [ExcludeFromInteractiveRouting]
@layout PrintLayout
@inject IPageService Pages
@inject NavigationManager Nav

<PageTitle>@(_model is null ? L["Print"] : $"{_model.SpaceName} · {L.Date(_model.Date, DateStyle.Short)}")</PageTitle>

@if (_model is not null)
{
    <div class="print-body">
        <div class="print-bar">
            <a class="btn btn-primary" href="@($"/export/page/{Id}.pdf")" download><Icon Name="download" Size="16" />@L["Download PDF"]</a>
            <button type="button" class="btn btn-secondary" onclick="window.print()"><Icon Name="print" Size="16" />@L["Print"]</button>
            <span class="muted">@L["Printing yourself? Set paper A4, margins None, scale 100%."]</span>
            <a class="btn btn-ghost" href="@($"/export/page/{Id}.html")" download>@L["Download HTML"]</a>
        </div>
        <A4Sheet Model="_model" Mode="SheetMode.Print" />
    </div>
    @if (Auto != 0)
    {
        @((MarkupString)"<script>window.addEventListener('load',()=>{document.fonts.ready.then(()=>setTimeout(()=>window.print(),350));});</script>")
    }
}

@code {
    [Parameter] public Guid Id { get; set; }
    [SupplyParameterFromQuery(Name = "auto")] public int? AutoQuery { get; set; }
    private int Auto => AutoQuery ?? 1;
    private SheetModel? _model;

    protected override async Task OnInitializedAsync()
    {
        _model = await Pages.GetSheetModelAsync(Id);
        if (_model is null) Nav.NotFound();
    }
}
