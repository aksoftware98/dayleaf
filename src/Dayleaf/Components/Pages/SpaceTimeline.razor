@page "/s/{Slug}"
@implements IAsyncDisposable
@inject ISpaceService Spaces
@inject ITimelineService Timeline
@inject IPageService Pages
@inject TimeProvider Clock
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>@(_space?.Name ?? "Space") · Dayleaf</PageTitle>

@if (_notFound)
{
    <div class="page-wrap"><EmptyState IconName="search" Title="That space isn't here" Text="It may have been renamed or deleted."><a class="btn btn-primary" href="/">Back to spaces</a></EmptyState></div>
}
else if (_space is not null)
{
    var color = SpaceColors.Get(_space.Color);
    <div class="topbar">
        <nav class="crumbs" aria-label="Breadcrumb">
            <a href="/"><Icon Name="back" Size="16" />Spaces</a>
            <span aria-hidden="true">/</span>
            <strong>@_space.Name</strong>
        </nav>
        <div class="toolbar">
            <label class="btn btn-secondary" style="position:relative">
                <Icon Name="calendar" Size="16" />Jump to date
                <input type="date" aria-label="Jump to date" style="position:absolute;inset:0;opacity:0;cursor:pointer" @onchange="JumpTo" />
            </label>
            <a class="icon-btn" href="@($"/s/{_space.Slug}/settings")" aria-label="Space settings"><Icon Name="settings" /></a>
            <a class="btn btn-primary" href="@($"/s/{_space.Slug}/{_today:yyyy-MM-dd}?new=1")"><Icon Name="plus" Size="16" />Today's page</a>
        </div>
    </div>

    <section class="banner @(_space.CoverMediaId is null ? "banner-plain" : "")" style="@(_space.CoverMediaId is null ? $"background:{color.Tint}" : "")">
        @if (_space.CoverMediaId is { } cover)
        {
            <img src="/media/@cover.ToString("N")" alt="" />
            <div class="banner-shade"></div>
        }
        <div class="banner-body">
            <span class="banner-emoji">@_space.Emoji</span>
            <div>
                <h1>@_space.Name</h1>
                <p>@_total page@(_total == 1 ? "" : "s")@(string.IsNullOrWhiteSpace(_space.Description) ? "" : $" · {_space.Description}")</p>
            </div>
        </div>
    </section>

    @if (_total == 0)
    {
        <div class="page-wrap">
            <EmptyState IconName="edit" Title="No pages yet" Text="Every day can have one page. Start with today, or go back and fill in a day you want to remember.">
                <div class="empty-actions">
                    <a class="btn btn-primary" href="@($"/s/{_space.Slug}/{_today:yyyy-MM-dd}?new=1")"><Icon Name="plus" Size="16" />Write today's page</a>
                    <label class="btn btn-secondary" style="position:relative"><Icon Name="calendar" Size="16" />Pick another date
                        <input type="date" aria-label="Pick a date" style="position:absolute;inset:0;opacity:0;cursor:pointer" @onchange="JumpTo" />
                    </label>
                </div>
            </EmptyState>
        </div>
    }
    else
    {
        <section class="scrubber" aria-label="Timeline">
            <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap">
                <div class="year-pills">
                    @foreach (var y in _years)
                    {
                        <button type="button" class="pill" aria-pressed="@(_year == y ? "true" : "false")" @onclick="() => SetYearAsync(y)">@y</button>
                    }
                </div>
                <span class="muted" style="font-size:13px">Tap a month to filter · use ← → to move page by page</span>
            </div>
            <MonthStrip Counts="_months" Selected="_month" SelectedChanged="SetMonthAsync" />
        </section>

        <div class="timeline-body">
            <ol class="tl" aria-label="Pages by date">
                @for (var i = 0; i < _list.Count; i++)
                {
                    var r = _list[i];
                    var current = _selected?.Id == r.Id;
                    <li class="@(current ? "is-current" : "")" @key="r.Id">
                        <div class="tl-date">
                            <span class="tl-day">@r.Date.Day.ToString("00")</span>
                            <span class="tl-mon">@r.Date.ToString("MMM", CultureInfo.InvariantCulture)</span>
                        </div>
                        <div class="tl-axis"><span class="tl-dot"></span><span class="tl-line"></span></div>
                        @if (current)
                        {
                            <a class="tl-card" href="@r.Url">
                                <div class="tl-row-meta"><strong>Page @r.Number · @r.Date.DayOfWeek</strong><span>@r.PhotoCount photo@(r.PhotoCount == 1 ? "" : "s") · @r.StickerCount sticker@(r.StickerCount == 1 ? "" : "s")</span></div>
                                <span class="tl-big-title">@(string.IsNullOrWhiteSpace(r.Title) ? "Untitled page" : r.Title)</span>
                                @if (!string.IsNullOrWhiteSpace(r.Excerpt))
                                {
                                    <span class="tl-excerpt">@r.Excerpt</span>
                                }
                                @if (r.PhotoIds.Count > 0)
                                {
                                    <div class="tl-photos">
                                        @foreach (var p in r.PhotoIds.Take(4))
                                        {
                                            <img src="/media/@p.ToString("N")" alt="" loading="lazy" />
                                        }
                                    </div>
                                }
                                <span style="font-size:13px;font-weight:600;color:var(--forest)">Open page →</span>
                            </a>
                        }
                        else
                        {
                            <button type="button" class="tl-card" @onclick="() => SelectAsync(r)">
                                <span class="tl-card-ico">
                                    @if (r.PhotoIds.Count > 0)
                                    {
                                        <img src="/media/@r.PhotoIds[0].ToString("N")" alt="" loading="lazy" />
                                    }
                                    else
                                    {
                                        <span aria-hidden="true">@_space.Emoji</span>
                                    }
                                </span>
                                <span style="display:flex;flex-direction:column;gap:2px;min-width:0">
                                    <span class="tl-card-title">@(string.IsNullOrWhiteSpace(r.Title) ? "Untitled page" : r.Title)</span>
                                    <span class="tl-card-meta">Page @r.Number · @r.Date.ToString("dddd", CultureInfo.InvariantCulture)</span>
                                </span>
                            </button>
                        }
                    </li>
                }
                @if (_list.Count == 0)
                {
                    <li class="muted" style="padding:20px 0">No pages in this month.</li>
                }
            </ol>

            @if (_selected is not null)
            {
                <aside class="preview" aria-label="Page preview">
                    <a href="@_selected.Url" aria-label="Open page">
                        <PageThumb Model="_preview" Width="397" />
                    </a>
                    <div class="preview-nav">
                        <button type="button" class="nav-card @(_pn?.Prev is null ? "disabled" : "")" @onclick="() => MoveAsync(-1)" aria-label="Previous page">
                            <Icon Name="back" Size="16" />
                            <span class="nav-card-txt"><strong>@(_pn?.Prev?.Date.ToString("MMM d", CultureInfo.InvariantCulture) ?? "First page")</strong>@if (_pn?.Prev is { } pv) {<small>Page @pv.Number</small>}</span>
                        </button>
                        <a class="btn btn-dark" href="@_selected.Url" style="flex:1.3">Open page</a>
                        <button type="button" class="nav-card @(_pn?.Next is null ? "disabled" : "")" style="justify-content:flex-end;text-align:right" @onclick="() => MoveAsync(1)" aria-label="Next page">
                            <span class="nav-card-txt"><strong>@(_pn?.Next?.Date.ToString("MMM d", CultureInfo.InvariantCulture) ?? "Latest")</strong>@if (_pn?.Next is { } nx) {<small>Page @nx.Number</small>}</span>
                            <Icon Name="forward" Size="16" />
                        </button>
                    </div>
                </aside>
            }
        </div>
    }
}

@code {
    [Parameter] public string Slug { get; set; } = "";
    [SupplyParameterFromQuery(Name = "d")] public string? D { get; set; }

    private Space? _space;
    private bool _notFound;
    private int _total;
    private List<int> _years = [];
    private int _year;
    private int? _month;
    private int[] _months = new int[12];
    private List<PageRef> _list = [];
    private PageRef? _selected;
    private SheetModel? _preview;
    private PrevNext? _pn;
    private DateOnly _today;
    private DotNetObjectReference<SpaceTimeline>? _ref;
    private IJSObjectReference? _module;
    private string? _loadedSlug;

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedSlug == Slug) return;
        _loadedSlug = Slug;
        _today = DateOnly.FromDateTime(Clock.GetLocalNow().DateTime);
        _space = await Spaces.GetBySlugAsync(Slug);
        _notFound = _space is null;
        if (_space is null) return;

        _years = await Timeline.GetYearsAsync(_space.Id);
        var all = await Timeline.ListPagesAsync(_space.Id);
        _total = all.Count;
        if (_total == 0) return;

        PageRef? start = null;
        if (DateOnly.TryParse(D, CultureInfo.InvariantCulture, out var d)) start = all.FirstOrDefault(r => r.Date == d);
        start ??= all[0];
        _year = start.Date.Year;
        _month = null;
        await LoadYearAsync();
        await SelectAsync(start);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _ref = DotNetObjectReference.Create(this);
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/dayleaf.js");
            await _module.InvokeVoidAsync("initListKeys", _ref);
        }
    }

    [JSInvokable]
    public Task OnListKey(string key) => key switch
    {
        "ArrowLeft" => MoveAsync(-1),
        "ArrowRight" => MoveAsync(1),
        "Enter" when _selected is not null => InvokeAsync(() => Nav.NavigateTo(_selected.Url)),
        _ => Task.CompletedTask,
    };

    private async Task LoadYearAsync()
    {
        _months = await Timeline.GetMonthCountsAsync(_space!.Id, _year);
        _list = await Timeline.ListPagesAsync(_space.Id, _year, _month);
    }

    private async Task SetYearAsync(int y)
    {
        _year = y;
        _month = null;
        await LoadYearAsync();
        if (_list.Count > 0) await SelectAsync(_list[0]);
    }

    private async Task SetMonthAsync(int? m)
    {
        _month = m;
        await LoadYearAsync();
        if (_list.Count > 0 && (_selected is null || !_list.Any(r => r.Id == _selected.Id))) await SelectAsync(_list[0]);
    }

    private async Task SelectAsync(PageRef r)
    {
        _selected = r;
        _preview = await Pages.GetSheetModelAsync(r.Id);
        _pn = await Timeline.GetPrevNextAsync(_space!.Id, r.Date);
        await InvokeAsync(StateHasChanged);
    }

    private async Task MoveAsync(int dir)
    {
        if (_pn is null) return;
        var target = dir < 0 ? _pn.Prev : _pn.Next;
        if (target is null) return;
        if (target.Date.Year != _year || (_month is { } m && target.Date.Month != m))
        {
            _year = target.Date.Year;
            _month = null;
            await LoadYearAsync();
        }
        await SelectAsync(_list.FirstOrDefault(x => x.Id == target.Id) ?? target);
    }

    private void JumpTo(ChangeEventArgs e)
    {
        if (DateOnly.TryParse(e.Value?.ToString(), CultureInfo.InvariantCulture, out var d))
            Nav.NavigateTo($"/s/{_space!.Slug}/{d:yyyy-MM-dd}");
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("disposeListKeys");
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException) { }
        }
        _ref?.Dispose();
    }
}
