    /// <summary>Decides which section receives new elements (plan §8): open draft, or ask about a section still in its grace window.</summary>
    private async Task<(bool Ok, Guid? SectionId)> ResolveTargetAsync()
    {
        _now = Clock.GetUtcNow();
        var sections = _page!.Sections;
        if (sections.Any(s => Policy.IsDraft(s, _now))) return (true, null);
        if (_chosenSection is { } chosen && sections.FirstOrDefault(s => s.Id == chosen) is { } cs && Policy.IsEditable(cs, _now)) return (true, chosen);
        _graceSection = sections.Where(s => Policy.State(s, _now) == SectionState.Submitted).OrderByDescending(s => s.Seq).FirstOrDefault();
        if (_graceSection is null) return (true, null); // service starts a new draft section

        _sectionAnswer = new TaskCompletionSource<bool>();
        _askSection = true;
        StateHasChanged();
        var useGrace = await _sectionAnswer.Task;
        if (useGrace)
        {
            _chosenSection = _graceSection.Id;
            return (true, _graceSection.Id);
        }
        return (true, null);
    }

    private void AnswerSection(bool useGrace)
    {
        _askSection = false;
        _sectionAnswer?.TrySetResult(useGrace);
    }

