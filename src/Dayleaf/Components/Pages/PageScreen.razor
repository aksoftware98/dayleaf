    }

    [JSInvokable]
    public async Task ToggleCheck(string id, int index)
    {
        if (!Guid.TryParse(id, out var gid) || _model?.Elements.FirstOrDefault(e => e.Element.Id == gid) is not { Data: ChecklistData c } item) return;
        if (index < 0 || index >= c.Items.Count) return;
        var copy = (ChecklistData)c.Copy();
        copy.Items[index].Done = !copy.Items[index].Done;
        await UpdateDataAsync(item, copy);
        StateHasChanged();
    }

    [JSInvokable]
    public async Task OnKey(string key, bool shift)
    {
        switch (key)
        {
            case "undo": await UndoAsync(); break;
