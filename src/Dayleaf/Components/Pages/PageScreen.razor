    private void Bump(Guid id) => _versions[id] = (_versions.TryGetValue(id, out var v) ? v : 0) + 1;

    private async Task UndoAsync()
    {
        if (_undo.Count == 0) return;
        var entry = _undo[^1];
        _undo.RemoveAt(_undo.Count - 1);
        await RunAsync(async () =>
        {
            if (entry.AddedId is { } added)
            {
                await Pages.DeleteElementAsync(added);
                if (_selectedId == added) _selectedId = null;
            }
            else if (entry.Before is { } b)
            {
                var exists = _model?.Elements.Any(e => e.Element.Id == b.Id) == true;
                if (exists)
                {
                    await Pages.TransformElementAsync(b.Id, b.Sheet, b.X, b.Y, b.W, b.H, b.Rotation);
                    await Pages.UpdateElementDataAsync(b.Id, b.ReadData());
                    if (b.Kind == ElementKind.Photo && b.MediaId is { } m) await Pages.SetElementMediaAsync(b.Id, m);
                    if (b.Kind == ElementKind.PageLink) await Pages.SetLinkTargetAsync(b.Id, b.LinkTargetPageId);
                    Bump(b.Id);
                }
                else
                {
                    var re = await Pages.AddElementAsync(b.PageId, b.Kind, b.ReadData(), b.MediaId, b.LinkTargetPageId,
                        (b.Sheet, b.X, b.Y), (b.W, b.H), b.Rotation, await EditableSectionOr(b.SectionId));
                    _selectedId = re.Id;
                }
            }
            await RefreshAsync();
        }, "Undone");
    }

    private Task<Guid?> EditableSectionOr(Guid sectionId)
    {
        var s = _page?.Sections.FirstOrDefault(x => x.Id == sectionId);
        return Task.FromResult(s is not null && Policy.IsEditable(s, Clock.GetUtcNow()) ? (Guid?)sectionId : null);
    }

