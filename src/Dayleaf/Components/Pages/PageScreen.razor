    private async Task<PageElement?> InsertAsync(ElementKind kind, ElementData data, Guid? media = null, Guid? link = null,
        (int Sheet, double X, double Y)? at = null, (double W, double H)? size = null, double? rotation = null, bool edit = false)
    {
        if (_page is null) return null;
        var (ok, sectionId) = await ResolveTargetAsync();
        if (!ok) return null;
        PageElement? el = null;
        await RunAsync(async () =>
        {
            el = await Pages.AddElementAsync(_page.Id, kind, data, media, link, at, size, rotation, sectionId);
            _undo.Add(new UndoEntry("add", null, el.Id));
            await RefreshAsync();
            _selectedId = el.Id;
        });
        if (el is not null)
        {
            StateHasChanged();
            await Task.Yield();
            if (_module is not null)
            {
                await _module.InvokeVoidAsync("scrollToElement", el.Id);
                if (edit) await _module.InvokeVoidAsync("beginTextEdit", el.Id);
            }
        }
        return el;
    }

