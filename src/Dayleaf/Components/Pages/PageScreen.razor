    [JSInvokable]
    public Task Select(string? id)
    {
        _selectedId = Guid.TryParse(id, out var g) ? g : null;
        StateHasChanged();
        return Task.CompletedTask;
    }

    [JSInvokable]
    public async Task CommitTransform(string id, int sheet, double x, double y, double w, double h, double rot)
    {
        if (!Guid.TryParse(id, out var gid) || _model is null) return;
        var item = _model.Elements.FirstOrDefault(e => e.Element.Id == gid);
        if (item is null) return;
        var before = item.Element.Clone();
        await RunAsync(async () =>
        {
            var saved = await Pages.TransformElementAsync(gid, sheet, x, y, w, h, rot);
            _undo.Add(new UndoEntry("move", before, null));
            var e = item.Element;
            (e.Sheet, e.X, e.Y, e.W, e.H, e.Rotation, e.UpdatedAt) = (saved.Sheet, saved.X, saved.Y, saved.W, saved.H, saved.Rotation, saved.UpdatedAt);
        });
        StateHasChanged();
    }

    [JSInvokable]
    public async Task CommitText(string id, string field, string value)
    {
        if (!Guid.TryParse(id, out var gid) || _model?.Elements.FirstOrDefault(e => e.Element.Id == gid) is not { } item) return;
        var data = item.Data.Copy();
        switch (data, field)
        {
            case (TextData t, "html"): t.Html = value; break;
            case (NoteData n, "html"): n.Html = value; break;
            case (NoteData n, "title"): n.Title = value; break;
            case (HeadingData hd, "text"): hd.Text = value; break;
            case (QuoteData q, "text"): q.Text = value; break;
            case (QuoteData q, "label"): q.Label = value; break;
            case (LabelData lb, "text"): lb.Text = value; break;
            case (PhotoData p, "caption"): p.Caption = value; break;
            case (ChecklistData c, "title"): c.Title = value; break;
            case (ChecklistData c, _) when field.StartsWith("item:") && int.TryParse(field[5..], out var idx) && idx < c.Items.Count:
                if (string.IsNullOrWhiteSpace(value)) c.Items.RemoveAt(idx); else c.Items[idx].Text = value;
                break;
            default: return;
        }
        Bump(gid);
        await RunAsync(async () =>
        {
            _undo.Add(new UndoEntry("text", item.Element.Clone(), null));
            await Pages.UpdateElementDataAsync(gid, data);
            await RefreshAsync();
        });
        StateHasChanged();
    }

    [JSInvokable]
    public async Task CommitTitle(string title)
    {
        _titleVersion++;
        await SaveMetaAsync(title: title);
