            case "delete": await ActionAsync(ElementAction.Delete); break;
            case "prev": Go(_pn?.Prev); break;
            case "next": Go(_pn?.Next); break;
            case "print":
                if (_model is not null && _module is not null) await _module.InvokeVoidAsync("openTab", $"/print/page/{_model.PageId}");
                break;
        }
        StateHasChanged();
    }

