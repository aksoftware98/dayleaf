    private async Task<MediaFile?> UploadAsync(IBrowserFile file)
    {
        try
        {
            var type = file.ContentType;
            IBrowserFile source = file;
            if (type is "image/jpeg" or "image/png" or "image/webp")
            {
                // The browser resizes big images; PNG and WebP keep transparency.
                source = await file.RequestImageFileAsync(type, 2400, 2400);
            }
            else if (type != "image/gif")
            {
                source = await file.RequestImageFileAsync("image/jpeg", 2400, 2400);
            }
            await using var stream = source.OpenReadStream(Media.MaxUploadBytes, _cts.Token);
            return await Media.SaveAsync(stream, file.Name, _cts.Token);
        }
        catch (Exception ex)
        {
            Toasts.Error($"{file.Name}: {ex.Message}");
            return null;
        }
    }

    private async Task OnFilesAsync(InputFileChangeEventArgs e)
    {
        if (_page is null || !CanEditOrCanAdd()) return;
        var files = e.GetMultipleFiles(20);
        var drop = _dropPoint;
        _dropPoint = null;
        var i = 0;
        _saveClass = "saving";
        foreach (var f in files)
        {
            var media = await UploadAsync(f);
            if (media is null) continue;
            var (w, h) = LayoutService.PhotoSize(media.Width, media.Height);
            if (files.Count > 1) (w, h) = (Math.Round(w * 0.6), Math.Round(h * 0.6));
            (int, double, double)? at = drop is { } d ? (d.Sheet, d.X - w / 2 + i * 34, d.Y - h / 2 + i * 34) : null;
            await InsertAsync(ElementKind.Photo, new PhotoData { Style = Styles[i % Styles.Length] }, media.Id, at: at, size: (w, h));
            i++;
        }
        _saveClass = "";
        if (i > 0) Toasts.Success(i == 1 ? "Photo added" : $"{i} photos added");
    }

    private static readonly string[] Styles = ["sticker", "polaroid", "taped"];

    private bool CanEditOrCanAdd() => _page is not null; // adding is always allowed: a new section opens if needed

