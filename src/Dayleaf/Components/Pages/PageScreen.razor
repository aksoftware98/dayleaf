    private async Task InspectorTransformAsync(SheetElement item, (double W, double H, double Rot, bool Commit) t)
    {
        var e = item.Element;
        if (!t.Commit)
        {
            e.W = t.W; e.H = t.H; e.Rotation = t.Rot;
            return;
        }
        await CommitTransform(e.Id.ToString(), e.Sheet, e.X, e.Y, t.W, t.H, t.Rot);
    }

    private Task RotateByAsync(SheetElement sel, double deg)
    {
        var e = sel.Element;
        var rot = e.Rotation + deg;
        if (rot > 180) rot -= 360;
        return CommitTransform(e.Id.ToString(), e.Sheet, e.X, e.Y, e.W, e.H, rot);
    }

    private Task CropAsync(SheetElement sel, PhotoData p)
    {
        var copy = (PhotoData)p.Copy();
        copy.Zoom = p.Zoom >= 3.9 ? 1 : Math.Round(p.Zoom + 0.5, 1);
        return UpdateDataAsync(sel, copy);
    }

    private async Task SetPhotoStyleAsync(SheetElement sel, string style)
    {
        var copy = (PhotoData)sel.Data.Copy();
        copy.Style = style;
        await UpdateDataAsync(sel, copy);
        var e = sel.Element;
        if (style == "round" && Math.Abs(e.W - e.H) > 0.5)
        {
            var side = Math.Min(e.W, e.H);
            await CommitTransform(e.Id.ToString(), e.Sheet, e.X + (e.W - side) / 2, e.Y + (e.H - side) / 2, side, side, e.Rotation);
        }
    }

    private async Task ActionAsync(ElementAction action)
    {
        if (Selected is not { Editable: true } sel) return;
        var id = sel.Element.Id;
        switch (action)
        {
            case ElementAction.Front:
                await RunAsync(async () => { await Pages.BringToFrontAsync(id); await RefreshAsync(); });
                break;
            case ElementAction.Back:
                await RunAsync(async () => { await Pages.SendToBackAsync(id); await RefreshAsync(); });
                break;
            case ElementAction.Duplicate:
                await RunAsync(async () =>
                {
                    var copy = await Pages.DuplicateElementAsync(id);
                    _undo.Add(new UndoEntry("add", null, copy.Id));
                    await RefreshAsync();
                    _selectedId = copy.Id;
                });
                break;
            case ElementAction.Delete:
                await RunAsync(async () =>
                {
                    var before = sel.Element.Clone();
                    await Pages.DeleteElementAsync(id);
                    _undo.Add(new UndoEntry("delete", before, null));
                    _selectedId = null;
                    await RefreshAsync();
                });
                Toasts.Show("Deleted · Ctrl+Z to undo");
                break;
        }
    }

